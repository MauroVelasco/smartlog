# --- AWS / CloudWatch (primary extraction point) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDWATCH_ENABLED=true
CLOUDWATCH_LOG_GROUPS=/ecs/app-service,/aws/rds/instance/app-db/error
CLOUDWATCH_FILTER_PATTERN=

# --- Tomcat (phase 1: enable alongside CloudWatch per POC scope) ---
TOMCAT_ENABLED=false
# Glob patterns are supported, so rotated/gzipped logs are picked up too.
TOMCAT_LOG_PATHS=/var/log/tomcat/catalina.out,/var/log/tomcat/catalina.*.log.gz

# --- GCP Logging (phase 2: "Expand & harden") ---
GCP_LOGGING_ENABLED=false
GCP_PROJECT_ID=
GCP_LOG_FILTER=
GOOGLE_APPLICATION_CREDENTIALS=

# --- DB logs: Oracle / MySQL / Postgres (phase 2) ---
# DB_LOG_SOURCES entries are "engine:connection_name" — connection_name maps
# to DATABASE_URL_<NAME> below (uppercased). One extractor class per engine
# (see extraction/db_log_extractor.py); each has its own permission
# requirement, noted next to its connection string.
DB_LOGS_ENABLED=false
DB_LOG_SOURCES=postgres:app,oracle:billing,mysql:orders

# Postgres: role needs pg_read_server_files (PG11+) or superuser, and
# log_line_prefix must include '%m [%p]' (the default on RDS/most installs).
DATABASE_URL_APP=postgresql+psycopg2://user:pass@host:5432/app

# Oracle: user needs SELECT on V$DIAG_ALERT_EXT (SELECT_CATALOG_ROLE or a
# DBA grant). Driver: pip install oracledb (python-oracledb, pure Python,
# no Oracle Instant Client required for thin mode).
DATABASE_URL_BILLING=oracle+oracledb://user:pass@host:1521/?service_name=billing

# MySQL: requires MySQL 8.0.22+ (performance_schema.error_log ships enabled
# by default). Driver: pip install pymysql (or mysqlclient).
DATABASE_URL_ORDERS=mysql+pymysql://user:pass@host:3306/orders

# --- Correlation (hybrid: deterministic first, LLM fallback) ---
DETERMINISTIC_TIME_WINDOW_SECONDS=300
SEMANTIC_TIME_BUCKET_SECONDS=120
SEMANTIC_MAX_BATCH_SIZE=25
SEMANTIC_MIN_CONFIDENCE=0.55
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# LLM_PROVIDER=openrouter
# OpenRouter is OpenAI-compatible (reuses ChatOpenAI with a different
# base_url) — model ids are slash-namespaced, e.g. "openai/gpt-4o-mini".
# OPENROUTER_API_KEY=
# One OpenRouter model id is served by many independent backend providers,
# and OpenRouter picks one per request. Some of them return tool-call
# arguments that .with_structured_output(CorrelationResult) cannot parse, so
# leaving this unset would make the correlation stage fail at random. Pin it
# to backends verified against the model you actually run: measured
# 2026-08-21 for z-ai/glm-5.2, Friendli and Fireworks returned valid tool
# calls 3/3, Together 1/3, BaseTen 0/3, Mistral 0/3.
# OPENROUTER_PROVIDER_ORDER=Friendli,Fireworks
# Set true to let routing leave the list above when those backends are down —
# trades reproducibility for availability.
# OPENROUTER_ALLOW_FALLBACKS=false

# --- Relationship Store ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/log_intelligence

# --- Visualization UI ---
VIZ_HOST=0.0.0.0
VIZ_PORT=8000
