          "p_message": "connection to server refused for database orders_app",
          "p_trx_id": "harness-t1-0001",
          "p_username": "harness-user-01",
          "p_component_id": "orders-service",
          "p_error_code": null,
          "p_identifier_free": false
        }
      },
      "emits": {
        "source_system": "postgres",
        "message_contains": "connection to server refused for database orders_app"
      }
    }
  ],
  "expected": {
    "edges": [
      {
        "from": "tomcat-db-error",
        "to": "pg-conn-refused",
        "relation_type": "id_match",
        "min_confidence": 1.0
      }
    ],
    "forbidden_edges": [],
    "incidents": [
      {
        "members": [
          "tomcat-db-error",
          "pg-conn-refused"
        ],
        "grouped": true
      }
    ]
  }
