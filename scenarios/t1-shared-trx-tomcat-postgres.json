{
  "case_id": "t1-shared-trx-tomcat-postgres",
  "tier": 1,
  "outcome_class": "positive-control",
  "title": "Shared trxId links Tomcat and Postgres deterministically",
  "identifier_free": false,
  "gated_by_phase3": false,
  "expected_stage": "deterministic",
  "use_llm": false,
  "steps": [
    {
      "id": "tomcat-db-error",
      "source": "tomcat",
      "wait_ms_before": 0,
      "http": {
        "path": "/api/orders/db-error",
        "query": {
          "trxId": "harness-t1-0001",
          "username": "harness-user-01",
          "componentId": "orders-service",
          "correlated": "true",
          "identifierFree": "false"
        }
